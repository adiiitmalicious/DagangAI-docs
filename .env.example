# =============================================================================
# DagangAI V1.0 â€” Environment Variables Template
# Salin file ini menjadi .env di root dan/atau apps/api & apps/web sesuai kebutuhan
# =============================================================================

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dagangai

# Backend Server
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT Authentication
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d

# Platform Admin Bootstrap (Seed)
ADMIN_EMAIL=admin@dagangai.app
ADMIN_FULL_NAME=Platform Admin DagangAI
ADMIN_PASSWORD=ChangeMeAdmin123!

# LLM Provider (Server-Side Only â€” Never expose to client)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=30000

# Object Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/api/v1/media
STORAGE_SIGNED_URL_SECRET=change-me-signed-url-secret-min-32-chars
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# S3 / Cloudflare R2 (Opsional untuk Staging/Production)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=dagangai-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Frontend (Next.js Public Env)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=DagangAI
